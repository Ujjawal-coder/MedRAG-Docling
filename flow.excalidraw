      "boundElements": [],
      "updated": 1789611689017,
      "link": null,
      "locked": false,
      "text": "1. RAG pipeline with Docling + Qdrant\n2. Working with Qdrant Vector Database\n3. Modular architecture for an AI application\n4. REST API design for AI services\n5. Testing with pytest\n6. Evaluation of RAG-based AI applications with DeepEval\n7. Dockerization of AI application\n8. CI/CD with GitHub Actions\n9. Deployment on AWS",
      "fontSize": 36,
      "fontFamily": 6,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "1. RAG pipeline with Docling + Qdrant\n2. Working with Qdrant Vector Database\n3. Modular architecture for an AI application\n4. REST API design for AI services\n5. Testing with pytest\n6. Evaluation of RAG-based AI applications with DeepEval\n7. Dockerization of AI application\n8. CI/CD with GitHub Actions\n9. Deployment on AWS",
      "autoResize": true,
      "lineHeight": 1.35
    },
